  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="FudbalDB">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=FudbalDB</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>bb6aaafb-974b-469f-ad4c-1673cdebea13</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>FudbalDB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Klub">
            <Value>=Parameters!Klub.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Sezona">
            <Value>=Parameters!Sezona.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT
    p.name                                        AS igrac,
    t.transfer_fee / 1000000.0                    AS placeno_mil,
    ISNULL(s.minuti, 0)                           AS minuti,
    s.vrednost_kraj / 1000000.0                   AS vrednost_kraj_mil,
    (s.vrednost_kraj - t.transfer_fee) / 1000000.0 AS razlika_mil
FROM dbo.fact_transfer t
JOIN dbo.dim_player p ON p.player_id = t.player_id
JOIN dbo.dim_date d   ON d.date_key = t.date_key
LEFT JOIN dbo.player_season_stats s
       ON s.player_id = t.player_id AND s.club_id = t.to_club_id AND s.sezona = d.season
WHERE t.to_club_id = @Klub
  AND d.season = @Sezona
  AND t.transfer_fee &gt; 0
ORDER BY t.transfer_fee DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="igrac">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>igrac</DataField>
        </Field>
        <Field Name="placeno_mil">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>placeno_mil</DataField>
        </Field>
        <Field Name="minuti">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>minuti</DataField>
        </Field>
        <Field Name="vrednost_kraj_mil">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>vrednost_kraj_mil</DataField>
        </Field>
        <Field Name="razlika_mil">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>razlika_mil</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Klubovi">
      <Query>
        <DataSourceName>FudbalDB</DataSourceName>
        <CommandText>SELECT DISTINCT c.club_id, c.name
FROM dbo.dim_club c
JOIN dbo.fact_club_match m ON m.club_id = c.club_id
WHERE m.competition_id = 'IT1'
ORDER BY c.name;</CommandText>
      </Query>
      <Fields>
        <Field Name="club_id">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>club_id</DataField>
        </Field>
        <Field Name="name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>name</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Sezone">
      <Query>
        <DataSourceName>FudbalDB</DataSourceName>
        <CommandText>SELECT DISTINCT season AS sezona, season_label
FROM dbo.dim_date
WHERE season BETWEEN 2021 AND 2025
ORDER BY season;</CommandText>
      </Query>
      <Fields>
        <Field Name="sezona">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>sezona</DataField>
        </Field>
        <Field Name="season_label">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>season_label</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
