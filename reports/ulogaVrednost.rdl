  <DataSources>
    <DataSource Name="FudbalDB">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=FudbalDB</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>2dae9074-2602-4673-8369-f07d23b8d984</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>FudbalDB</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT
    sezona,
    CASE WHEN minuti &gt;= 1500 THEN '1. Postava'
         WHEN minuti &gt;= 500  THEN '2. Rotacija'
         ELSE '3. Rezerva' END AS uloga,
    igrac,
    starost,
    minuti,
    golova,
    asistencija,
    vrednost_pocetak / 1000000.0                    AS vrednost_pocetak_mil,
    vrednost_kraj / 1000000.0                       AS vrednost_kraj_mil,
    (vrednost_kraj - vrednost_pocetak) / 1000000.0  AS rast_mil
FROM dbo.player_season_stats
WHERE club_id = 1047
ORDER BY sezona, uloga, rast_mil DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="sezona">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>sezona</DataField>
        </Field>
        <Field Name="uloga">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>uloga</DataField>
        </Field>
        <Field Name="igrac">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>igrac</DataField>
        </Field>
        <Field Name="starost">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>starost</DataField>
        </Field>
        <Field Name="minuti">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>minuti</DataField>
        </Field>
        <Field Name="golova">
