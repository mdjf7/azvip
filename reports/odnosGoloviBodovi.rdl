  <DataSources>
    <DataSource Name="FudbalDB">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=FudbalDB</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>7ef81205-400c-4f1c-9176-bd6b193ef004</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Utakmice">
      <Query>
        <DataSourceName>FudbalDB</DataSourceName>
        <CommandText>SELECT
    d.season_label                    AS sezona,
    d.season_half                     AS polusezona,
    m.matchday                        AS kolo,
    d.[date]                          AS datum,
    o.name                            AS protivnik,
    CASE WHEN m.is_home = 1 THEN 'Domaćin' ELSE 'Gost' END AS teren,
    m.goals_for                       AS dato,
    m.goals_against                   AS primljeno,
    m.points                          AS bodova
FROM dbo.fact_club_match m
JOIN dbo.dim_date d ON d.date_key = m.date_key
JOIN dbo.dim_club o ON o.club_id = m.opponent_id
WHERE m.club_id = 1047 AND m.competition_id = 'IT1'
ORDER BY m.date_key;</CommandText>
      </Query>
      <Fields>
        <Field Name="sezona">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>sezona</DataField>
        </Field>
        <Field Name="polusezona">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>polusezona</DataField>
        </Field>
        <Field Name="kolo">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>kolo</DataField>
        </Field>
        <Field Name="datum">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>datum</DataField>
        </Field>
        <Field Name="protivnik">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>protivnik</DataField>
        </Field>
        <Field Name="teren">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>teren</DataField>
        </Field>
        <Field Name="dato">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>dato</DataField>
        </Field>
        <Field Name="primljeno">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>primljeno</DataField>
        </Field>
        <Field Name="bodova">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>bodova</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
