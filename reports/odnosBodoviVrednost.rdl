  <DataSources>
    <DataSource Name="FudbalDB">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=FudbalDB</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>46a42fe2-c686-49c5-838c-086f5aaeae63</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>FudbalDB</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>WITH vrednost AS (
    SELECT club_id, sezona, SUM(vrednost_pocetak) AS vrednost_tima
    FROM dbo.player_season_stats
    WHERE liga = 'IT1'
    GROUP BY club_id, sezona
)
SELECT
    c.name                          AS klub,
    d.season_label                  AS sezona,
    SUM(m.points)                   AS bodova,
    v.vrednost_tima / 1000000.0     AS vrednost_tima_mil
FROM dbo.fact_club_match m
JOIN vrednost v       ON v.club_id = m.club_id AND v.sezona = m.season
JOIN dbo.dim_club c   ON c.club_id = m.club_id
JOIN dbo.dim_date d   ON d.date_key = m.date_key
WHERE m.competition_id = 'IT1'
GROUP BY c.name, d.season_label, v.vrednost_tima;</CommandText>
      </Query>
      <Fields>
        <Field Name="klub">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>klub</DataField>
        </Field>
        <Field Name="sezona">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>sezona</DataField>
        </Field>
        <Field Name="bodova">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>bodova</DataField>
        </Field>
        <Field Name="vrednost_tima_mil">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>vrednost_tima_mil</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
